# 复制为 config.env 后填写（config.env 已被 .gitignore 忽略，不会提交密钥）

# 转写后端：api（调用在线接口）或 local（本机 faster-whisper）
STT_BACKEND=api
STT_LANGUAGE=zh

# --- api 后端：任何兼容 OpenAI /audio/transcriptions 的服务 ---
# 硅基流动 SiliconFlow（中文推荐，SenseVoice）
STT_BASE_URL=https://api.siliconflow.cn/v1
STT_MODEL=FunAudioLLM/SenseVoiceSmall
# OpenAI：STT_BASE_URL=https://api.openai.com/v1   STT_MODEL=gpt-4o-transcribe（或 whisper-1）
# Groq：  STT_BASE_URL=https://api.groq.com/openai/v1   STT_MODEL=whisper-large-v3
STT_API_KEY=
# 每段切片秒数（OpenAI 单文件上限 25MB，600 秒约 5MB，一般不用改）
STT_CHUNK_SECONDS=600

# --- local 后端（需要能访问 huggingface.co 下载模型，或填本地模型目录）---
STT_LOCAL_MODEL=large-v3
STT_LOCAL_DEVICE=cpu
STT_LOCAL_COMPUTE=int8
