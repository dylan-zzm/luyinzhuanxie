# 复制为 config.env 后按需修改（config.env 已被 .gitignore 忽略，不会提交密钥）
# 不建 config.env 也能用：默认就是项目内的本地小模型。

# 转写后端：local（默认，项目内小模型，免费离线）或 api（在线接口，备用）
STT_BACKEND=local
STT_LANGUAGE=zh
# 说话人数：2 = 销售 + 客户；有多人参与时填实际人数，或 -1 让模型自动判断
STT_SPEAKERS=2

# --- api 后端（可选）：任何兼容 OpenAI /audio/transcriptions 的服务 ---
# Groq（有免费额度）：
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
# OpenAI：STT_BASE_URL=https://api.openai.com/v1   STT_MODEL=gpt-4o-transcribe
# 硅基流动：STT_BASE_URL=https://api.siliconflow.cn/v1   STT_MODEL=FunAudioLLM/SenseVoiceSmall
STT_API_KEY=
STT_CHUNK_SECONDS=600
